# Backend Environment Variables (copy to .env and fill in)

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/coursemaster

# Secret used to sign JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: lets a user register as admin by entering this key on the Register page
ADMIN_REGISTRATION_KEY=change-me-admin-key

# Optional: welcome emails (leave empty to disable)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173
